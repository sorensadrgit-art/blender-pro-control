BLENDER_USER_CONFIG=/var/lib/blender-pro/config/render-safe
BLENDER_USER_DATAFILES=/var/lib/blender-pro/datafiles/render-safe
BLENDER_USER_SCRIPTS=/opt/blender-pro/system/scripts
BLENDER_USER_EXTENSIONS=/var/lib/blender-pro/extensions/render-safe
BLENDER_SYSTEM_EXTENSIONS=/opt/blender-pro/system/extensions
TMPDIR=/run/blender-pro
XDG_CACHE_HOME=/var/cache/blender-pro
