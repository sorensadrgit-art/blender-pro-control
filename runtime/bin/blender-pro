#!/usr/bin/env bash
set -euo pipefail
ROOT=/opt/blender-pro
PROFILE=${BLENDER_PRO_PROFILE:-render-safe}
PROFILE_FILE="$ROOT/profiles/$PROFILE.env"
if [ ! -r "$PROFILE_FILE" ]; then
  echo "Unknown Blender Pro profile: $PROFILE" >&2
  exit 64
fi
set -a
. "$PROFILE_FILE"
set +a
EXTRA=()
case "$PROFILE" in
  render-safe) EXTRA+=(--offline-mode --disable-autoexec) ;;
  asset-fetch) EXTRA+=(--disable-autoexec) ;;
  *) echo "Unsupported Blender Pro profile: $PROFILE" >&2; exit 64 ;;
esac
exec "$ROOT/current/blender" "${EXTRA[@]}" "$@"
